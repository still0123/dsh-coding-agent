{
  "name": "dsh-coding-agent",
  "version": "0.1.0",
  "description": "DSH coding-agent distribution with a reproduce-first ReproFix repair mode.",
  "type": "module",
  "bin": {
    "dshagent": "./client/cli.mjs",
    "dshagent-client": "./client/server.mjs",
    "dshagent-presets": "./scripts/install-presets.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "demos",
    "fixtures",
    "preset",
    "scripts/demo.mjs",
    "scripts/install-presets.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run test/domain.test.ts test/guard.test.ts test/runner.test.ts test/workflow.test.ts test/receipt.test.ts test/phase0.smoke.test.ts test/local-client.test.ts test/install-presets.test.ts test/workspace-lock.test.ts test/cli.test.ts test/benchmark.test.ts",
    "benchmark": "node benchmark/run.mjs",
    "build": "tsc --pretty false",
    "client": "node client/server.mjs",
    "dshagent": "node client/cli.mjs",
    "demo:not-reproduced": "node scripts/demo.mjs not-reproduced",
    "demo:fixed": "node scripts/demo.mjs fixed",
    "demo:validation-failed": "node scripts/demo.mjs validation-failed",
    "test:integration": "vitest run test/repair-failure.integration.test.ts test/golden-fixture.integration.test.ts",
    "test:preset-smoke": "vitest run test/dsh-preset.smoke.test.ts",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow-worker-thread": "0.1.0-rc.6",
    "@types/node": "22.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
